# Онлайн-синхронизация прогресса 3D-мира «Остров Эха».
# Скопируйте этот файл в .env, укажите адрес вашего REST API и перезапустите:
#   npm run web
#
# Базовый URL без завершающего слэша. Если не задан — приложение работает
# офлайн-only (прогресс хранится только на устройстве).
# Локальный бэкенд из папки server/ (node server/index.js):
VITE_WORLD_SYNC_URL=http://localhost:4000
# На другом устройстве вместо localhost укажите IP компьютера в сети,
# например: http://192.168.1.5:4000

# Ожидаемый контракт API (по childId):
#   GET  {BASE}/world-progress/{childId}
#        -> 200 { "state": "<строка>", "updatedAt": 1700000000000 }
#        -> 404, если данных ещё нет
#   PUT  {BASE}/world-progress/{childId}
#        body { "childId": "...", "state": "<строка>", "updatedAt": 1700000000000 }
#        -> 200
